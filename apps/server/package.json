{
  "name": "@querydock/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "pnpm -w exec vitest run --config apps/server/vitest.config.mts",
    "test:watch": "pnpm -w exec vitest --config apps/server/vitest.config.mts",
    "test:integration": "pnpm -w exec vitest run --config apps/server/vitest.config.mts apps/server/test/postgres-migration.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@querydock/contracts": "workspace:*",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.0"
  }
}
