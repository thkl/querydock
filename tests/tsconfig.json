{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@querydock/contracts": ["../packages/contracts/src/index.ts"]
    },
    "types": ["node"],
    "typeRoots": ["../apps/server/node_modules/@types"]
  },
  "include": [
    "**/*.spec.ts",
    "../apps/server/test/**/*.spec.ts",
    "../apps/web/test/**/*.spec.ts"
  ]
}
